                {
                    "dataset": "mlflow",
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "mlflow-datasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT \n  to_timestamp(m.timestamp / 1000) AS time,\n  r.run_uuid,\n  MAX(CASE WHEN m.key = 'f1_score' THEN m.value ELSE NULL END) AS \"f1_score\",\n  MAX(CASE WHEN m.key = 'accuracy' THEN m.value ELSE NULL END) AS \"accuracy\",\n  MAX(CASE WHEN m.key = 'roc_auc_curve' THEN m.value ELSE NULL END) AS \"roc_auc_curve\"\nFROM metrics m\nJOIN runs r ON m.run_uuid = r.run_uuid\nWHERE m.key IN ('f1_score', 'accuracy', 'roc_auc_curve')\nGROUP BY time, r.run_uuid\nORDER BY time ASC;",
                    "refId": "A",
                    "sql": {
                        "columns": [
                            {
                                "parameters": [],
                                "type": "function"
                            }
                        ],
                        "groupBy": [
                            {
                                "property": {
                                    "type": "string"
                                },
                                "type": "groupBy"
                            }
                        ],
                        "limit": 50
                    }
                }
            ],
            "title": "Model Performance Overtime",
            "type": "timeseries"
